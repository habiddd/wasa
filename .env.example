

# ---------------------------------------------------------------
# Postgres (superusuario del contenedor; crea las 2 bases de datos)
# ---------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_super_strong_password

# Base de datos de tu app (creada por postgres/init/01-init.sql)
APP_DB_NAME=reservas_db
APP_DB_USER=reservas_user
APP_DB_PASSWORD=changeme_app_strong_password

# ---------------------------------------------------------------
# Baileys (WhatsApp no oficial, gratuito)
# ---------------------------------------------------------------
# Clave para autenticar las peticiones entre Flask y Baileys.
# OBLIGATORIA: `baileys-bot` rechaza con 401 toda petición a POST /send que
# no traiga esta clave en el header `x-api-key`, y si la variable queda
# vacía falla cerrado (no envía nada y avisa al arrancar). Sin esto,
# cualquiera con acceso de red al puerto 3000 podría hacer que el número
# de la LACS enviara mensajes arbitrarios.
FLASK_API_KEY=changeme_genera_una_clave_larga_aleatoria

# ---------------------------------------------------------------
# Flask
# ---------------------------------------------------------------
FLASK_ENV=development
FLASK_SECRET_KEY=changeme_otra_clave_larga_aleatoria

# ---------------------------------------------------------------
# LLM local, API compatible con OpenAI (Ollama o LM Studio)
# ---------------------------------------------------------------
# Si el LLM corre en otra máquina de tu red, usa su IP (ej: 192.168.3.167).
# Si corre en el mismo Windows/Mac donde está Docker Desktop (no dentro de
# otro contenedor), usa host.docker.internal en vez de 127.0.0.1/localhost:
# dentro del contenedor de flask-app esos apuntan al propio contenedor.
LLM_BASE_URL=http://192.168.3.167:9000
LLM_MODEL=llama3.1
# Deja vacío si tu servidor local no exige autenticación (LM Studio/Ollama
# no la requieren). Algunos backends OpenAI-compatible sí la piden.
LLM_API_KEY=

# ---------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------
MAX_MESSAGES_PER_MINUTE=8

# ---------------------------------------------------------------
# Dashboard interno (/dashboard) - estado de servicios, QR y métricas
# ---------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme_otra_clave_larga_aleatoria

# ---------------------------------------------------------------
# Catálogo web
# ---------------------------------------------------------------
# URL de la página con el catálogo completo de equipos y espacios. El bot la
# envía cuando alguien consulta disponibilidad sin nombrar un activo que
# reconozca. Vacía = el bot lista el estado de todo el inventario (como
# antes). PENDIENTE: la URL definitiva la entrega la LACS.
CATALOGO_URL=
